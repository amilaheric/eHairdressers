
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Required - signing key for JWT access tokens (min. 32 random characters).
# Generate one with: openssl rand -base64 32
JWT_SECRET_KEY=

# Optional - only needed if you want the worker service to send real emails.
# Leave blank to run without email (the worker will just log instead of sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_ADDRESS=noreply@ehairdressers.local
