
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Required - signing key for JWT access tokens (min. 32 random characters).
# Generate one with: openssl rand -base64 32
JWT_SECRET_KEY=

# Required - SQL Server "sa" login password. Must satisfy SQL Server's
# password complexity rules, and must match the password embedded in
# DB_CONNECTION_STRING below (this one just bootstraps the sqlserver
# container itself).
DB_SA_PASSWORD=

# Required - full connection string used by the API. "sqlserver" is the
# docker-compose service name, so this only works when running via
# docker compose (not for a local `dotnet run` outside Docker - use
# `dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."` for that).
DB_CONNECTION_STRING=Data Source=sqlserver;Initial Catalog=IB160064;User ID=sa;Password=CHANGE_ME;TrustServerCertificate=True

# Required - RabbitMQ credentials shared by the rabbitmq container, the API,
# and the worker service.
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Optional - RabbitMQ connection details. Defaults match the docker-compose
# service name/port and only need changing for non-Docker setups.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# Optional - only needed if you want the worker service to send real emails.
# Leave blank to run without email (the worker will just log instead of sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_ADDRESS=noreply@ehairdressers.local

# Required - API base URL for the Flutter apps. Flutter doesn't read .env
# files itself, so pass these explicitly when you run/build, e.g.:
#   flutter run --dart-define=baseUrl=http://10.0.2.2:7051/       (mobile, Android emulator)
#   flutter run --dart-define=baseUrl=http://localhost:7051/      (desktop)
# Android emulator can't reach "localhost" (that's the emulator itself) - it
# must use 10.0.2.2, the special alias for the host machine's localhost.
# A physical Android device instead needs your PC's real LAN IP here.
API_BASE_URL_MOBILE=http://10.0.2.2:7051/
API_BASE_URL_DESKTOP=http://localhost:7051/
